//
// Team-calendar demo for fumola in the browser.
//
// One shared TEE holds the team's calendar. Three people (alice, bob,
// carol) each have a 5-day availability schedule (one cell per day,
// true=free, false=busy). The TEE exposes several derived views, all
// computed from the same cells:
//
//   /free/<name>    per-person free-day count
//   /pair/ab        first day alice and bob are both free
//   /pair/ac        same for alice and carol
//   /pair/bc        same for bob and carol
//   /team           first day all three are free
//
// What the demo shows is what makes Adapton specifically useful:
// successive queries reuse the cached sub-computations of earlier
// queries. The team query uses pair-thunks; pair queries use cells.
// Forcing /team after /pair/ab re-uses every pair_ab_<day> thunk for
// free, and only computes pair_ac and pair_bc on demand.
//
// Per-call output:  { result; new_misses; new_hits; cumulative_misses;
// cumulative_hits }  so the page can show the cache growing live.
//
module {

  // -----------------------------------------------------------------
  // Initial schedule. Picked so each query has a distinct first-true
  // day and the team query exercises every pair.
  //
  //         mon  tue  wed  thu  fri
  // alice:   T    F    T    T    F
  // bob:     T    T    F    T    F
  // carol:   F    T    T    T    T
  //
  // Expected first feasible days:
  //   pair AB: mon (both free)
  //   pair AC: wed (alice free, carol free)
  //   pair BC: tue
  //   team:    thu (all three free)
  // -----------------------------------------------------------------

  public func setup() {
    // Person cells.
    `alice-`mon := true;   `alice-`tue := false;
    `alice-`wed := true;   `alice-`thu := true;
    `alice-`fri := false;
    `bob-`mon := true;     `bob-`tue := true;
    `bob-`wed := false;    `bob-`thu := true;
    `bob-`fri := false;
    `carol-`mon := false;  `carol-`tue := true;
    `carol-`wed := true;   `carol-`thu := true;
    `carol-`fri := true;

    let am = prim "adaptonPointer" (`alice-`mon);
    let at = prim "adaptonPointer" (`alice-`tue);
    let aw = prim "adaptonPointer" (`alice-`wed);
    let ah = prim "adaptonPointer" (`alice-`thu);
    let af = prim "adaptonPointer" (`alice-`fri);
    let bm = prim "adaptonPointer" (`bob-`mon);
    let bt = prim "adaptonPointer" (`bob-`tue);
    let bw = prim "adaptonPointer" (`bob-`wed);
    let bh = prim "adaptonPointer" (`bob-`thu);
    let bf = prim "adaptonPointer" (`bob-`fri);
    let cm = prim "adaptonPointer" (`carol-`mon);
    let ct = prim "adaptonPointer" (`carol-`tue);
    let cw = prim "adaptonPointer" (`carol-`wed);
    let ch = prim "adaptonPointer" (`carol-`thu);
    let cf = prim "adaptonPointer" (`carol-`fri);

    // Per-person free counts.
    `alice-`free_count := thunk {
      (if (@ am) { 1 } else { 0 })
      + (if (@ at) { 1 } else { 0 })
      + (if (@ aw) { 1 } else { 0 })
      + (if (@ ah) { 1 } else { 0 })
      + (if (@ af) { 1 } else { 0 })
    };
    `bob-`free_count := thunk {
      (if (@ bm) { 1 } else { 0 })
      + (if (@ bt) { 1 } else { 0 })
      + (if (@ bw) { 1 } else { 0 })
      + (if (@ bh) { 1 } else { 0 })
      + (if (@ bf) { 1 } else { 0 })
    };
    `carol-`free_count := thunk {
      (if (@ cm) { 1 } else { 0 })
      + (if (@ ct) { 1 } else { 0 })
      + (if (@ cw) { 1 } else { 0 })
      + (if (@ ch) { 1 } else { 0 })
      + (if (@ cf) { 1 } else { 0 })
    };

    // Pair AB thunks per day.
    `pair_ab-`mon := thunk { (@ am) and (@ bm) };
    `pair_ab-`tue := thunk { (@ at) and (@ bt) };
    `pair_ab-`wed := thunk { (@ aw) and (@ bw) };
    `pair_ab-`thu := thunk { (@ ah) and (@ bh) };
    `pair_ab-`fri := thunk { (@ af) and (@ bf) };
    // Pair AC.
    `pair_ac-`mon := thunk { (@ am) and (@ cm) };
    `pair_ac-`tue := thunk { (@ at) and (@ ct) };
    `pair_ac-`wed := thunk { (@ aw) and (@ cw) };
    `pair_ac-`thu := thunk { (@ ah) and (@ ch) };
    `pair_ac-`fri := thunk { (@ af) and (@ cf) };
    // Pair BC.
    `pair_bc-`mon := thunk { (@ bm) and (@ cm) };
    `pair_bc-`tue := thunk { (@ bt) and (@ ct) };
    `pair_bc-`wed := thunk { (@ bw) and (@ cw) };
    `pair_bc-`thu := thunk { (@ bh) and (@ ch) };
    `pair_bc-`fri := thunk { (@ bf) and (@ cf) };

    // First-day-feasible-for-pair thunks.
    let pab_m = prim "adaptonPointer" (`pair_ab-`mon);
    let pab_t = prim "adaptonPointer" (`pair_ab-`tue);
    let pab_w = prim "adaptonPointer" (`pair_ab-`wed);
    let pab_h = prim "adaptonPointer" (`pair_ab-`thu);
    let pab_f = prim "adaptonPointer" (`pair_ab-`fri);
    `first_pair_ab := thunk {
      if (force pab_m) { ?#mon }
      else if (force pab_t) { ?#tue }
      else if (force pab_w) { ?#wed }
      else if (force pab_h) { ?#thu }
      else if (force pab_f) { ?#fri }
      else null
    };
    let pac_m = prim "adaptonPointer" (`pair_ac-`mon);
    let pac_t = prim "adaptonPointer" (`pair_ac-`tue);
    let pac_w = prim "adaptonPointer" (`pair_ac-`wed);
    let pac_h = prim "adaptonPointer" (`pair_ac-`thu);
    let pac_f = prim "adaptonPointer" (`pair_ac-`fri);
    `first_pair_ac := thunk {
      if (force pac_m) { ?#mon }
      else if (force pac_t) { ?#tue }
      else if (force pac_w) { ?#wed }
      else if (force pac_h) { ?#thu }
      else if (force pac_f) { ?#fri }
      else null
    };
    let pbc_m = prim "adaptonPointer" (`pair_bc-`mon);
    let pbc_t = prim "adaptonPointer" (`pair_bc-`tue);
    let pbc_w = prim "adaptonPointer" (`pair_bc-`wed);
    let pbc_h = prim "adaptonPointer" (`pair_bc-`thu);
    let pbc_f = prim "adaptonPointer" (`pair_bc-`fri);
    `first_pair_bc := thunk {
      if (force pbc_m) { ?#mon }
      else if (force pbc_t) { ?#tue }
      else if (force pbc_w) { ?#wed }
      else if (force pbc_h) { ?#thu }
      else if (force pbc_f) { ?#fri }
      else null
    };

    // Team-day thunks: AB and AC must both be true (which suffices to
    // imply BC, given alice's freeness on a given day). Defined this
    // way so team_<day> reuses the pair-thunk cache: forcing /team
    // after /pair/ab gets cache hits on every pair_ab_<day>.
    `team-`mon := thunk { (force pab_m) and (force pac_m) };
    `team-`tue := thunk { (force pab_t) and (force pac_t) };
    `team-`wed := thunk { (force pab_w) and (force pac_w) };
    `team-`thu := thunk { (force pab_h) and (force pac_h) };
    `team-`fri := thunk { (force pab_f) and (force pac_f) };

    let tm = prim "adaptonPointer" (`team-`mon);
    let tt = prim "adaptonPointer" (`team-`tue);
    let tw = prim "adaptonPointer" (`team-`wed);
    let th = prim "adaptonPointer" (`team-`thu);
    let tf = prim "adaptonPointer" (`team-`fri);
    `first_team := thunk {
      if (force tm) { ?#mon }
      else if (force tt) { ?#tue }
      else if (force tw) { ?#wed }
      else if (force th) { ?#thu }
      else if (force tf) { ?#fri }
      else null
    };
    "ok"
  };

  // -----------------------------------------------------------------
  // Counter-aware query helper. Each query snapshots the cache stats
  // before and after, so the page can show the per-call delta and the
  // running total.
  // -----------------------------------------------------------------

  func snapshot() : { hits : Any; misses : Any } {
    {
      hits = @ (`adapton(`counts)(`forceBeginCacheHit));
      misses = @ (`adapton(`counts)(`forceBeginCacheMiss));
    }
  };

  func with_counters(tag, p) {
    let s0 = snapshot();
    let v = force p;
    let s1 = snapshot();
    {
      view = tag;
      result = v;
      new_misses = (s1.misses) - (s0.misses);
      new_hits = (s1.hits) - (s0.hits);
      cumulative_misses = s1.misses;
      cumulative_hits = s1.hits;
    }
  };

  public func freeCount(who) {
    switch (who) {
      case (#alice) { with_counters(#alice_free, prim "adaptonPointer" (`alice-`free_count)) };
      case (#bob)   { with_counters(#bob_free,   prim "adaptonPointer" (`bob-`free_count)) };
      case (#carol) { with_counters(#carol_free, prim "adaptonPointer" (`carol-`free_count)) };
    }
  };

  public func firstPair(pair) {
    switch (pair) {
      case (#ab) { with_counters(#first_pair_ab, prim "adaptonPointer" (`first_pair_ab)) };
      case (#ac) { with_counters(#first_pair_ac, prim "adaptonPointer" (`first_pair_ac)) };
      case (#bc) { with_counters(#first_pair_bc, prim "adaptonPointer" (`first_pair_bc)) };
    }
  };

  public func firstTeam() {
    with_counters(#first_team, prim "adaptonPointer" (`first_team))
  };

  // Peek the DCG of a named root. Useful for the receipt rendering.
  public func peek(name) {
    let p = switch (name) {
      case (#alice_free)    { prim "adaptonPointer" (`alice-`free_count) };
      case (#bob_free)      { prim "adaptonPointer" (`bob-`free_count) };
      case (#carol_free)    { prim "adaptonPointer" (`carol-`free_count) };
      case (#first_pair_ab) { prim "adaptonPointer" (`first_pair_ab) };
      case (#first_pair_ac) { prim "adaptonPointer" (`first_pair_ac) };
      case (#first_pair_bc) { prim "adaptonPointer" (`first_pair_bc) };
      case (#first_team)    { prim "adaptonPointer" (`first_team) };
    };
    let cell = (prim "adaptonPeekCell" p);
    switch (cell) {
      case (?c) { c.outgoingEdges };
      case (null) { [] };
    }
  };

  // -----------------------------------------------------------------
  // HTTP handler — delegates to the query funcs.
  // -----------------------------------------------------------------
  public func handle(method, path, body) {
    if (path == "/setup") {
      { status = 200; headers = {}; body = setup() }
    } else if (path == "/free/alice") {
      { status = 200; headers = {}; body = freeCount(#alice) }
    } else if (path == "/free/bob") {
      { status = 200; headers = {}; body = freeCount(#bob) }
    } else if (path == "/free/carol") {
      { status = 200; headers = {}; body = freeCount(#carol) }
    } else if (path == "/pair/ab") {
      { status = 200; headers = {}; body = firstPair(#ab) }
    } else if (path == "/pair/ac") {
      { status = 200; headers = {}; body = firstPair(#ac) }
    } else if (path == "/pair/bc") {
      { status = 200; headers = {}; body = firstPair(#bc) }
    } else if (path == "/team") {
      { status = 200; headers = {}; body = firstTeam() }
    } else if (path == "/peek/alice_free") {
      { status = 200; headers = {}; body = peek(#alice_free) }
    } else if (path == "/peek/bob_free") {
      { status = 200; headers = {}; body = peek(#bob_free) }
    } else if (path == "/peek/carol_free") {
      { status = 200; headers = {}; body = peek(#carol_free) }
    } else if (path == "/peek/first_pair_ab") {
      { status = 200; headers = {}; body = peek(#first_pair_ab) }
    } else if (path == "/peek/first_pair_ac") {
      { status = 200; headers = {}; body = peek(#first_pair_ac) }
    } else if (path == "/peek/first_pair_bc") {
      { status = 200; headers = {}; body = peek(#first_pair_bc) }
    } else if (path == "/peek/first_team") {
      { status = 200; headers = {}; body = peek(#first_team) }
    } else if (path == "/" or path == "") {
      {
        status = 200; headers = {};
        body = "{ \"endpoints\": [\"/setup\", \"/free/{alice,bob,carol}\", \"/pair/{ab,ac,bc}\", \"/team\", \"/peek/<view>\"] }";
      }
    } else {
      { status = 404; headers = {}; body = "not found" }
    }
  };
}
